<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.08</Version>
    <InformationalVersion>1.08</InformationalVersion>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <FileVersion>1.0.8.0</FileVersion>
    <Company>tetherWorks</Company>
    <Copyright>Copyright (c) 2026 tetherWorks</Copyright>
    <RepositoryUrl>https://github.com/tether-works/IgnisDisc</RepositoryUrl>
    <PackageProjectUrl>https://ignisdisc.tetherworks.dev</PackageProjectUrl>
  </PropertyGroup>
</Project>
