<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The setup wizard and installed uninstaller (Uninstall-IgnisDisc.exe). It is published self-contained into the same
    folder as IgnisDisc.exe and ignisdisc-cli.exe, so all three share one copy of the .NET runtime. The small
    IgnisDisc-Setup.exe launcher (tools/CdBurner.SetupBootstrapper) unpacks that folder and runs this wizard from it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Uninstall-IgnisDisc</AssemblyName>
    <Product>IgnisDisc Optical Studio</Product>
    <Title>IgnisDisc Optical Studio Setup</Title>
    <RootNamespace>CdBurner.Setup</RootNamespace>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationIcon>IgnisDisc.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CdBurner.Setup.Tests" />
  </ItemGroup>

</Project>
