<Application x:Class="CdBurner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:views="clr-namespace:CdBurner.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CdBurner.App;component/Themes/FluentTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:NavigationTabToBooleanConverter x:Key="NavigationTabToBooleanConverter" />
            <converters:CapacityStatusToBrushConverter x:Key="CapacityStatusToBrushConverter" />
            <converters:MediaPresenceToBrushConverter x:Key="MediaPresenceToBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
            <converters:FileSystemPresetToStringConverter x:Key="FileSystemPresetToStringConverter" />
            <converters:AudioRecordingModeToBooleanConverter x:Key="AudioRecordingModeToBooleanConverter" />
            <converters:SectorHealthStatusToBrushConverter x:Key="SectorHealthStatusToBrushConverter" />

            <!-- DataTemplates for Master Workspaces -->
            <DataTemplate DataType="{x:Type vm:DataBurnViewModel}">
                <views:DataBurnView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DvdVideoViewModel}">
                <views:DvdVideoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioBurnViewModel}">
                <views:AudioBurnView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImageStudioViewModel}">
                <views:ImageStudioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriveUtilitiesViewModel}">
                <views:DriveUtilitiesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VirtualDriveViewModel}">
                <views:VirtualDriveView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BurnProgressViewModel}">
                <views:BurnProgressView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
