<Window x:Class="CdBurner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
        xmlns:converters="clr-namespace:CdBurner.App.Converters"
        mc:Ignorable="d"
        Title="IgnisDisc Optical Studio v1.03"
        Icon="Assets/IgnisDisc.png"
        Height="760"
        Width="1160"
        MinHeight="620"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- DataTemplate for Workspace Modules -->
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="16"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Workspace Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Workspace Separator -->
                    <Separator Grid.Row="1"
                               Background="{DynamicResource CardBorderBrush}"
                               Margin="0,0,0,20" />

                    <!-- Workspace Content or Placeholder Surface -->
                    <Grid Grid.Row="2">
                        <!-- Custom module content (e.g. DataBurnView, DvdVideoView) -->
                        <ContentControl Content="{Binding Content}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Visibility="{Binding Content, Converter={StaticResource NullToVisibilityConverter}}" />

                        <!-- Placeholder surface when no active view model is attached -->
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="24"
                                Visibility="{Binding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Optical Mastering Workspace"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Zone 1: Top Drive / Media Ribbon -->
            <RowDefinition Height="Auto" />
            <!-- Zone 2: Navigation Rail & Main ContentHost -->
            <RowDefinition Height="*" />
            <!-- Zone 3: Bottom Capacity & Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ZONE 1: TOP RECORDER & MEDIA RIBBON                                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource RibbonBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Drive Selector & Refresh -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Burn To Drive:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />

                    <!-- Drive DropDown -->
                    <ComboBox Width="280"
                              ItemsSource="{Binding AvailableRecorders}"
                              SelectedItem="{Binding SelectedRecorder}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VolumePath}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding VendorId}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ProductId}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" (Virtual)"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding IsVirtual, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Refresh Button -->
                    <Button Content="↻ Refresh"
                            Command="{Binding RefreshDrivesCommand}"
                            ToolTip="Scan and re-enumerate optical recorders"
                            Margin="8,0,0,0" />

                    <Separator Style="{x:Null}" Width="1" Height="24" Background="{DynamicResource CardBorderBrush}" Margin="12,0" />

                    <!-- Media Badge -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding CurrentMediaStatus.MediaPresent, Converter={StaticResource MediaPresenceToBrushConverter}}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MediaBadgeText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Tray Buttons -->
                    <Button Content="⏏ Eject"
                            Command="{Binding EjectTrayCommand}"
                            ToolTip="Open drive tray or unmount media"
                            Margin="8,0,0,0" />
                    <Button Content="📥 Close"
                            Command="{Binding CloseTrayCommand}"
                            ToolTip="Close drive tray and load media"
                            Margin="4,0,0,0" />
                </StackPanel>

                <!-- Right: Write Speed & Virtual Media Quick-Mount -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Speed:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />

                    <ComboBox Width="130"
                              ItemsSource="{Binding AvailableWriteSpeeds}"
                              SelectedItem="{Binding SelectedWriteSpeed}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Separator Style="{x:Null}" Width="1" Height="24" Background="{DynamicResource CardBorderBrush}" Margin="12,0" />

                    <!-- Virtual Media Quick-Mount Menu / Buttons -->
                    <TextBlock Text="Mount Virtual:"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,6,0" />
                    <Button Content="CD-R"
                            Command="{Binding MountVirtualBlankCdRCommand}"
                            ToolTip="Mount blank 700 MB CD-R into virtual drive"
                            Padding="8,4"
                            Margin="2,0" />
                    <Button Content="CD-RW"
                            Command="{Binding MountVirtualBlankCdRwCommand}"
                            ToolTip="Mount blank 700 MB CD-RW rewritable into virtual drive"
                            Padding="8,4"
                            Margin="2,0" />
                    <Button Content="DVD-R"
                            Command="{Binding MountVirtualBlankDvdRCommand}"
                            ToolTip="Mount blank 4.7 GB DVD-R into virtual drive"
                            Padding="8,4"
                            Margin="2,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ZONE 2: LEFT NAVIGATION RAIL + MAIN CONTENTHOST                          -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Navigation Rail (7 module tabs) -->
                <ColumnDefinition Width="220" />
                <!-- Content Host Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Rail -->
            <Border Grid.Column="0"
                    Background="{DynamicResource RailBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="4,12">
                <StackPanel>
                    <TextBlock Text="OPTICAL MASTERING"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="16,4,0,10" />

                    <!-- Tab 1: Data Disc -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DataDisc}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DataDisc}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Data Disc" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 2: Audio CD -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=AudioCd}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.AudioCd}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎵" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Audio CD" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 3: DVD-Video -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DvdVideo}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DvdVideo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎬" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="DVD-Video" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 4: Disc Image Studio -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=ImageStudio}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.ImageStudio}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💿" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Disc Image Studio" />
                        </StackPanel>
                    </RadioButton>

                    <Separator Style="{x:Null}" Height="1" Background="{DynamicResource CardBorderBrush}" Margin="12,12" />

                    <TextBlock Text="TOOLS &amp; SETTINGS"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="16,4,0,10" />

                    <!-- Tab 5: Drive Utilities -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=DriveUtilities}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.DriveUtilities}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Drive Utilities" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 6: Virtual Drive -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=VirtualDrive}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.VirtualDrive}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Virtual Drive" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 7: Settings -->
                    <RadioButton Style="{StaticResource NavigationRailButtonStyle}"
                                 IsChecked="{Binding SelectedNavigationTab, Converter={StaticResource NavigationTabToBooleanConverter}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationTab.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Main ContentHost -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentWorkspaceViewModel}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- ========================================================================= -->
        <!-- ZONE 3: BOTTOM CAPACITY METER & STATUS BAR                               -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Drive Summary -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DriveStatusSummary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="|"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MediaDetailsText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Segmented Capacity Progress Bar -->
                <Grid Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock HorizontalAlignment="Left"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Used: " />
                            <Run Text="{Binding CapacityUsedMbText, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" / " />
                            <Run Text="{Binding CapacityMaxMbText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding CapacityLbaText, Mode=OneWay}" />
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding CapacityUsagePercent, Mode=OneWay}"
                                 Foreground="{Binding CurrentCapacity.Status, Converter={StaticResource CapacityStatusToBrushConverter}}" />
                </Grid>

                <!-- Right: Capacity Status Pill -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{Binding CurrentCapacity.Status, Converter={StaticResource CapacityStatusToBrushConverter}}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CapacityStatusText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
