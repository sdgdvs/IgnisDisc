<UserControl x:Class="CdBurner.App.Views.DriveUtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DriveUtilitiesViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:SectorHealthStatusToBrushConverter x:Key="HealthToBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Drive Selection Ribbon -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Section 1 & 2 (Inspector & Erase/Bitsetting side-by-side) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Section 3 (Surface Scanner) -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Status & Progress Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: DRIVE SELECTION BAR                                               -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Target Drive:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,10,0" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableRecorders}"
                              SelectedItem="{Binding SelectedRecorder}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2"
                            Content="↻ Refresh Capabilities"
                            Command="{Binding RefreshCapabilitiesCommand}"
                            Margin="10,0,0,0"
                            Padding="12,5" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: MMC INSPECTOR & ERASING / BITSETTING                               -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 1: MMC Drive & Media Inspector -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="🔍 MMC Drive &amp; Media Inspector"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Device Geometry -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hardware:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold">
                                <Run Text="{Binding SelectedRecorder.VendorId, Mode=OneWay}" />
                                <Run Text="{Binding SelectedRecorder.ProductId, Mode=OneWay}" />
                                <Run Text=" Rev " />
                                <Run Text="{Binding SelectedRecorder.ProductRevision, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Media Type:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding MediaDetails.MediaType, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Media Status:" Foreground="{DynamicResource TextMutedBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Blank: " Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding MediaDetails.IsBlank, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="Rewritable: " Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding MediaDetails.IsRewritable, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sectors:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding MediaDetails.TotalSectors, Mode=OneWay, StringFormat='{}{0:N0}'}" />
                                <Run Text=" total (" />
                                <Run Text="{Binding MediaDetails.FreeSectors, Mode=OneWay, StringFormat='{}{0:N0}'}" />
                                <Run Text=" free)" />
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Book Type:" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding MediaDetails.BookType, Mode=OneWay, TargetNullValue='N/A'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,8,0,8" />

                        <!-- Write Capabilities Badges -->
                        <TextBlock Text="Write Capabilities:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="CD-R" FontSize="11" Foreground="{Binding Capabilities.CanWriteCdR, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="CD-RW" FontSize="11" Foreground="{Binding Capabilities.CanWriteCdRw, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD-R" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdR, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD-RW" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdRw, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD+R" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdPlusR, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD+RW" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdPlusRw, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD+R DL" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdPlusRDL, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                            <Border Background="{DynamicResource RibbonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="2">
                                <TextBlock Text="DVD-RAM" FontSize="11" Foreground="{Binding Capabilities.CanWriteDvdRam, Converter={StaticResource BooleanToBrushConverter}}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Rewritable Erase & DVD Book Type Bitsetting -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <!-- Erase Subsection -->
                        <TextBlock Text="🧹 Rewritable Disc Erase"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Erase CD-RW, DVD-RW, DVD+RW, or DVD-RAM rewritable media."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="Quick Erase (TOC / PMA Blank)"
                                         IsChecked="{Binding IsFullEraseSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}"
                                         GroupName="EraseTypeGroup"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="Full Erase (Complete Zero-Fill)"
                                         IsChecked="{Binding IsFullEraseSelected}"
                                         GroupName="EraseTypeGroup" />
                        </StackPanel>

                        <Button Content="Erase Rewritable Disc"
                                Command="{Binding EraseDiscCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Padding="16,6"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16" />

                        <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12" />

                        <!-- Bitsetting Subsection -->
                        <TextBlock Text="🏷️ DVD Book Type Bitsetting"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Change optical descriptor book type (e.g. DVD+R / DVD+R DL to DVD-ROM) for maximum legacy player compatibility."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Target Book Type:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableBookTypes}"
                                      SelectedItem="{Binding SelectedBookType}" />
                            <Button Grid.Column="2"
                                    Content="Apply Bitsetting"
                                    Command="{Binding ApplyBookTypeCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    Margin="10,0,0,0"
                                    Padding="14,5" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 2: OPTICAL SECTOR SURFACE SCANNER                                     -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Scanner Header & Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔬 Sector Surface Scanner &amp; Transfer Benchmark"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Scans optical medium sectors, verifies ECC integrity, and identifies Slow or Damaged blocks."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="Block Size (Sectors):"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" />

                        <ComboBox Grid.Column="2"
                                  Width="90"
                                  ItemsSource="{Binding AvailableBlockSizes}"
                                  SelectedItem="{Binding ScanBlockSizeSectors}"
                                  VerticalAlignment="Center" />

                        <Button Grid.Column="3"
                                Content="Start Surface Scan"
                                Command="{Binding StartSurfaceScanCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Margin="12,0,0,0"
                                Padding="16,6"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar Grid.Row="1"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding OperationProgress}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Margin="0,0,0,12" />

                    <!-- Scan Metrics Pill Bar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource RibbonBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SCANNED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.TotalSectorsScanned, StringFormat='{}{0:N0} LBAs', TargetNullValue='0 LBAs'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GOOD BLOCKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CapacitySafeBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.GoodBlocks, TargetNullValue='0'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CapacitySafeBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SLOW BLOCKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CapacityWarningBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.SlowBlocks, TargetNullValue='0'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CapacityWarningBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="DAMAGED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CapacityOverburnBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.DamagedBlocks, TargetNullValue='0'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CapacityOverburnBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AVG SPEED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.AverageSpeedKbPerSec, StringFormat='{}{0:F0} KiB/s', TargetNullValue='0 KiB/s'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="5">
                                <TextBlock Text="MAX SPEED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LatestScanReport.MaxSpeedKbPerSec, StringFormat='{}{0:F0} KiB/s', TargetNullValue='0 KiB/s'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Visual Sector Surface Map Grid -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            MinHeight="180"
                            MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScanBlocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="12" Height="12"
                                                Margin="1"
                                                CornerRadius="2"
                                                Background="{Binding Status, Converter={StaticResource HealthToBrush}}">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding StartLba, StringFormat='Start LBA: {0:N0}'}" />
                                                        <TextBlock Text="{Binding SectorCount, StringFormat='Sectors: {0:N0}'}" />
                                                        <TextBlock Text="{Binding ReadSpeedKilobytesPerSec, StringFormat='Throughput: {0:F1} KiB/s'}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
