<UserControl x:Class="CdBurner.App.Views.ImageStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImageStudioViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BooleanToBrushConverter x:Key="BoolToBrush" />
    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- ========================================================================= -->
            <!-- TAB 1: BURN DISC IMAGE (.ISO / .CUE)                                     -->
            <!-- ========================================================================= -->
            <TabItem Header="🔥 Burn Disc Image" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Source Image Selection Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Source Image:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding SourceImagePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="📂 Browse..."
                                    Command="{Binding BrowseImageCommand}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="3"
                                    Content="🔍 Inspect"
                                    Command="{Binding InspectImageCommand}"
                                    VerticalAlignment="Center" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Center">
                                <CheckBox Content="Verify media bit-for-bit after burn completes"
                                          IsChecked="{Binding VerifyAfterBurn}"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Image Format & Metrics Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Format Card -->
                            <StackPanel Grid.Column="0" Margin="4,0">
                                <TextBlock Text="Detected Format"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding DetectedImageFormat}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>

                            <!-- Sector Count -->
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="Sector Extents"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ImageSectorCount, StringFormat='{}{0:N0} LBAs'}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Byte Size -->
                            <StackPanel Grid.Column="2" Margin="4,0">
                                <TextBlock Text="Payload Byte Size"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ImageSizeFormatted}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Spacer / Preview Surface -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Ready to Burn Disc Image"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Supports standard ISO 9660 / Joliet / UDF data images (.iso) and CDRWIN Red Book audio/mixed-mode sheets (.cue + .bin)."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom Burn Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="🔥 Burn Image to Disc"
                                    Command="{Binding BurnImageToDiscCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="24,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 2: RIP DISC TO IMAGE (.ISO / .BIN+.CUE)                              -->
            <!-- ========================================================================= -->
            <TabItem Header="💿 Rip Disc to Image" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Destination Path Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Destination File:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding RipTargetFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="📂 Browse..."
                                    Command="{Binding BrowseRipTargetFileCommand}"
                                    VerticalAlignment="Center" />

                            <!-- Mode Toggles -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        Orientation="Horizontal"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Rip Mode:"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,0" />
                                <RadioButton Content="Standard ISO Image (Mode 1 / 2,048 B)"
                                             IsChecked="{Binding RipRawBinCueMode, Converter={StaticResource InverseBooleanConverter}}"
                                             GroupName="RipModeGroup"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="Raw BIN + CUE Sheet (2,352 B / Mixed-Mode)"
                                             IsChecked="{Binding RipRawBinCueMode}"
                                             GroupName="RipModeGroup" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Mode Explanations Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Digital Extraction Engine"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="• Standard ISO: Rips pure user data sectors (2,048 bytes), suitable for software discs, DVDs, and single-session data."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2" />
                            <TextBlock Text="• Raw BIN/CUE: Extracts complete 2,352-byte sectors including sync headers, subchannel data, and generates CDRWIN CUE layout."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Ready to Rip Optical Disc"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Select target recorder in top ribbon, specify destination path, and click 'Rip Disc to Image'."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom Rip Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="💿 Rip Disc to Image"
                                    Command="{Binding RipDiscToImageCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="24,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 3: STANDALONE SECTOR / SHA-256 VERIFIER                              -->
            <!-- ========================================================================= -->
            <TabItem Header="🔍 Standalone Verifier" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Target File & Trigger Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Reference Image:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding SourceImagePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="📂 Browse..."
                                    Command="{Binding BrowseImageCommand}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="3"
                                    Content="🔍 Verify Disc"
                                    Command="{Binding VerifyDiscAgainstImageCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                       Text="Compares every physical/virtual optical sector bit-for-bit against reference image calculating CRC32, MD5, and SHA-256."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <!-- Verification Diagnostics Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Checksum Match Badge Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                        BorderBrush="{Binding IsChecksumMatch, Converter={StaticResource BoolToBrush}}"
                                        BorderThickness="2"
                                        CornerRadius="16"
                                        Padding="14,6">
                                    <TextBlock Text="{Binding VerificationStatusText}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Expected SHA-256 -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="Expected Image SHA-256:"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding CalculatedSha256, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Courier New, monospace"
                                         FontSize="12"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </StackPanel>

                            <!-- Disc Actual SHA-256 -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                                <TextBlock Text="Actual Media Sectors SHA-256:"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding DiscSha256, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Courier New, monospace"
                                         FontSize="12"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </StackPanel>

                            <Separator Grid.Row="3" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,16" />

                            <!-- Diagnostic Note -->
                            <TextBlock Grid.Row="4"
                                       Text="If sector mismatches are detected, any defective logical block addresses (LBAs) will be mapped to their corresponding file paths."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Bottom Status Bar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="{Binding VerificationStatusText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BurnProgress}"
                                         VerticalAlignment="Bottom"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
