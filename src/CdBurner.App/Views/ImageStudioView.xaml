<UserControl x:Class="CdBurner.App.Views.ImageStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImageStudioViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BooleanToBrushConverter x:Key="BoolToBrush" />
    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl KeyboardNavigation.TabNavigation="Local" Background="Transparent" BorderThickness="0">
            <!-- ========================================================================= -->
            <!-- TAB 1: BURN DISC IMAGE (.ISO / .CUE)                                     -->
            <!-- ========================================================================= -->
            <TabItem Header="🔥 Burn Disc Image" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Source Image Selection Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Source Image:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     AutomationProperties.Name="Source Image"
                                     Text="{Binding SourceImagePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="📂 Browse..."
                                    AutomationProperties.Name="Browse Source Image"
                                    Command="{Binding BrowseImageCommand}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="3"
                                    Content="🔍 Inspect"
                                    AutomationProperties.Name="Inspect Image"
                                    Command="{Binding InspectImageCommand}"
                                    VerticalAlignment="Center" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Center">
                                <CheckBox Content="Verify media bit-for-bit after burn completes"
                                          AutomationProperties.Name="Verify media bit-for-bit after burn completes"
                                          IsChecked="{Binding VerifyAfterBurn}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,20,0" />
                                            <CheckBox Content="Direct drive commands (experimental)"
                                                      AutomationProperties.Name="Direct drive commands (experimental)"
                                                      IsChecked="{Binding UseDirectDriveCommands}"
                                                      ToolTip="Burn with IgnisDisc's own drive commands instead of the Windows writer, at a speed taken from the drive's own list for the disc, then read the disc back to check it. Covers blank CD-R, CD-RW, DVD-R, DVD-RW, single-layer DVD+R, DVD+RW and DVD-RAM so far; other discs are burned by the Windows writer as before."
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,20,0" />
                                <Button Content="🔄 Convert Image (BIN/CUE ↔ ISO, Legacy)..."
                                        AutomationProperties.Name="Convert Legacy Image to ISO"
                                        Command="{Binding ConvertLegacyImageToIsoCommand}"
                                        Visibility="{Binding IsLegacyImageLoaded, Converter={StaticResource BoolToVis}}"
                                        Padding="12,4"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Image Format & Metrics Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Format Card -->
                            <StackPanel Grid.Column="0" Margin="4,0">
                                <TextBlock Text="Detected Format"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding DetectedImageFormat}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>

                            <!-- Sector Count -->
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="Sector Extents"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ImageSectorCount, StringFormat='{}{0:N0} LBAs'}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Byte Size -->
                            <StackPanel Grid.Column="2" Margin="4,0">
                                <TextBlock Text="Payload Byte Size"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ImageSizeFormatted}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Real-Time Write Speed & Buffer Telemetry -->
                            <StackPanel Grid.Column="3" Margin="4,0">
                                <TextBlock Text="Speed &amp; Buffer Telemetry"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding CurrentSpeedDisplay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Drive Buf:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Width="52" />
                                    <ProgressBar Width="70" Height="6" Minimum="0" Maximum="100" Value="{Binding DeviceBufferPercent}" Margin="0,0,6,0"
                                                 AutomationProperties.Name="Drive Buffer" />
                                    <TextBlock Text="{Binding DeviceBufferPercent, StringFormat='{}{0:F0}%'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Telemetry & Hardware I/O Log Surface -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Supported: ISO (.iso), CDRWIN (.cue + .bin/.flac/.wav), Nero (.nrg), Alcohol 120% (.mds/.mdf), CloneCD (.ccd/.img)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="🧹 Clear Log"
                                        AutomationProperties.Name="Clear Log"
                                        Command="{Binding ClearOperationLogCommand}"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right"
                                        Padding="8,2"
                                        FontSize="11" />
                            </DockPanel>
                            <ListBox Grid.Row="1"
                                     AutomationProperties.Name="Operation Log"
                                     ItemsSource="{Binding OperationLogEntries}"
                                     FontFamily="Consolas, Courier New, monospace"
                                     FontSize="11.5"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />
                        </Grid>
                    </Border>

                    <!-- Bottom Burn Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             AutomationProperties.Name="Burn Progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Burn To:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox Width="260"
                                          AutomationProperties.Name="Burn To Optical Drive"
                                          ItemsSource="{Binding AvailableRecorders}"
                                          SelectedItem="{Binding SelectedRecorder}"
                                          ToolTip="Select the optical drive to burn this image to">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛑 Cancel"
                                        AutomationProperties.Name="Cancel Burn"
                                        Command="{Binding CancelCommand}"
                                        Background="#D83B01"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,0,8,0" />
                                <Button Content="➕ Add to Queue"
                                        AutomationProperties.Name="Add Image to Burn Queue"
                                        Command="{Binding AddToBurnQueueCommand}"
                                        Padding="16,10"
                                        FontSize="14"
                                        Margin="0,0,8,0" />
                                <Button Content="🔥 Burn Image to Disc"
                                        AutomationProperties.Name="Burn Image to Disc"
                                        Command="{Binding BurnImageToDiscCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 2: RIP DISC TO IMAGE (.ISO / .BIN+.CUE)                              -->
            <!-- ========================================================================= -->
            <TabItem Header="💿 Rip Disc to Image" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Destination Path Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Destination File:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     AutomationProperties.Name="Destination File"
                                     Text="{Binding RipTargetFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="📂 Browse..."
                                    AutomationProperties.Name="Browse Destination File"
                                    Command="{Binding BrowseRipTargetFileCommand}"
                                    VerticalAlignment="Center" />

                            <!-- Mode Toggles -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        Orientation="Horizontal"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Rip Mode:"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,0" />
                                <RadioButton Content="Standard ISO Image (Mode 1 / 2,048 B)"
                                             AutomationProperties.Name="Standard ISO Image (Mode 1 / 2,048 B)"
                                             IsChecked="{Binding RipRawBinCueMode, Converter={StaticResource InverseBooleanConverter}}"
                                             GroupName="RipModeGroup"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="Raw BIN + CUE Sheet (2,352 B / Mixed-Mode)"
                                             AutomationProperties.Name="Raw BIN + CUE Sheet (2,352 B / Mixed-Mode)"
                                             IsChecked="{Binding RipRawBinCueMode}"
                                             GroupName="RipModeGroup" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Mode Explanations Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Digital Extraction Engine"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="• Standard ISO: Rips pure user data sectors (2,048 bytes), suitable for software discs, DVDs, and single-session data."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2" />
                            <TextBlock Text="• Raw BIN/CUE: Extracts complete 2,352-byte sectors including sync headers, subchannel data, and generates CDRWIN CUE layout."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Ready to Rip Optical Disc"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Select target recorder in top ribbon, specify destination path, and click 'Rip Disc to Image'."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom Rip Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             AutomationProperties.Name="Rip Progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛑 Cancel"
                                        AutomationProperties.Name="Cancel Rip"
                                        Command="{Binding CancelCommand}"
                                        Background="#D83B01"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,0,8,0" />
                                <Button Content="💿 Rip Disc to Image"
                                        AutomationProperties.Name="Rip Disc to Image"
                                        Command="{Binding RipDiscToImageCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 3: STANDALONE SECTOR / SHA-256 VERIFIER                              -->
            <!-- ========================================================================= -->
            <TabItem Header="🔍 Standalone Verifier" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Target File & Trigger Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Reference Image:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     AutomationProperties.Name="Reference Image"
                                     Text="{Binding SourceImagePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="📂 Browse..."
                                    AutomationProperties.Name="Browse Reference Image"
                                    Command="{Binding BrowseImageCommand}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛑 Cancel"
                                        AutomationProperties.Name="Cancel Verify"
                                        Command="{Binding CancelCommand}"
                                        Background="#D83B01"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,8,0" />
                                <Button Content="🔍 Verify Disc"
                                        AutomationProperties.Name="Verify Disc"
                                        Command="{Binding VerifyDiscAgainstImageCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                       Text="Compares every physical/virtual optical sector bit-for-bit against reference image calculating CRC32, MD5, and SHA-256."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <!-- Verification Diagnostics Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Checksum Match Badge Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                        BorderBrush="{Binding IsChecksumMatch, Converter={StaticResource BoolToBrush}}"
                                        BorderThickness="2"
                                        CornerRadius="16"
                                        Padding="14,6">
                                    <TextBlock Text="{Binding VerificationStatusText}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Expected SHA-256 -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Text="Expected Image SHA-256:"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding CalculatedSha256, Mode=OneWay}"
                                         AutomationProperties.Name="Expected Image SHA-256"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Courier New, monospace"
                                         FontSize="12"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </StackPanel>

                            <!-- Disc Actual SHA-256 -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                                <TextBlock Text="Actual Media Sectors SHA-256:"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding DiscSha256, Mode=OneWay}"
                                         AutomationProperties.Name="Actual Media Sectors SHA-256"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Courier New, monospace"
                                         FontSize="12"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </StackPanel>

                            <Separator Grid.Row="3" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,16" />

                            <!-- Diagnostic Note -->
                            <TextBlock Grid.Row="4"
                                       Text="If sector mismatches are detected, any defective logical block addresses (LBAs) will be mapped to their corresponding file paths."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Bottom Status Bar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="{Binding VerificationStatusText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <ProgressBar Height="6"
                                         AutomationProperties.Name="Verification Progress"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BurnProgress}"
                                         VerticalAlignment="Bottom"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 4: 1-CLICK DISC COPY & MULTI-COPY BATCH                              -->
            <!-- ========================================================================= -->
            <TabItem Header="🔁 1-Click Disc Copy" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Source & Target Drive Selection Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Source Reader Drive -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Source Drive (Read):"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      AutomationProperties.Name="Source Drive (Read)"
                                      ItemsSource="{Binding AvailableRecorders}"
                                      SelectedItem="{Binding CopySourceRecorder}"
                                      Padding="8,5">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding VendorId}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding ProductId}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Target Writer Drive -->
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="Target Drive (Write):"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <ComboBox Grid.Row="0" Grid.Column="4"
                                      AutomationProperties.Name="Target Drive (Write)"
                                      ItemsSource="{Binding AvailableRecorders}"
                                      SelectedItem="{Binding CopyTargetRecorder}"
                                      Padding="8,5">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding VendorId}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding ProductId}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Batch Copy Options -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                        Orientation="Horizontal"
                                        Margin="0,14,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Copies to Burn:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <TextBox Width="56"
                                         AutomationProperties.Name="Copies to Burn"
                                         Text="{Binding CopyCount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         TextAlignment="Center"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Margin="0,0,20,0" />

                                <CheckBox Content="Verify each burned copy bit-for-bit"
                                          AutomationProperties.Name="Verify each burned copy bit-for-bit"
                                          IsChecked="{Binding CopyVerifyEachDisc}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,20,0" />

                                <CheckBox Content="Raw 2,352-byte Clone Mode (.bin + .cue)"
                                          AutomationProperties.Name="Raw 2,352-byte Clone Mode (.bin + .cue)"
                                          IsChecked="{Binding CopyRawCloneMode}"
                                          ToolTip="Data discs only. Reads raw 2,352-byte sectors into a .bin + .cue staging image (kept when 'Keep temporary staged image' is on). Windows' burning service writes the 2,048-byte data, so the burned copy is the same as a normal copy. Audio CDs are always copied track by track."
                                          VerticalAlignment="Center"
                                          Margin="0,0,20,0" />

                                <CheckBox Content="Keep temporary staged image"
                                          AutomationProperties.Name="Keep temporary staged image"
                                          IsChecked="{Binding CopyKeepStagedImage}"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                       Text="Supports both dual-drive direct cloning and single-drive disc-swap copying (automatically extracts Data/DVD or Red Book Audio CD + CD-Text to a staging image, then burns 1..99 target copies)."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <!-- Hardware Log & Buffer Monitor -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <ListBox ItemsSource="{Binding OperationLogEntries}"
                                 AutomationProperties.Name="Copy Operation Log"
                                 FontFamily="Consolas, Courier New, monospace"
                                 FontSize="11.5"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                    </Border>

                    <!-- Bottom Copy Action Bar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             AutomationProperties.Name="Copy Progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛑 Cancel"
                                        AutomationProperties.Name="Cancel Copy"
                                        Command="{Binding CancelCommand}"
                                        Background="#D83B01"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,0,8,0" />
                                <Button Content="🔁 Start 1-Click Disc Copy"
                                        AutomationProperties.Name="Start 1-Click Disc Copy"
                                        Command="{Binding CopyDiscCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 5: SEQUENTIAL BURN QUEUE                                              -->
            <!-- ========================================================================= -->
            <TabItem Header="📋 Burn Queue" Padding="12,6" FontSize="13">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Queue Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sequential Image Burn Queue"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Queue multiple ISO or legacy images to burn sequentially with automated disc swap prompts and after-burn actions."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➕ Add Image..."
                                        AutomationProperties.Name="Add Image to Queue"
                                        Command="{Binding AddToBurnQueueCommand}"
                                        Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="➖ Remove"
                                        AutomationProperties.Name="Remove Selected Queue Item"
                                        Command="{Binding RemoveFromBurnQueueCommand}"
                                        Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="🗑️ Clear"
                                        AutomationProperties.Name="Clear Burn Queue"
                                        Command="{Binding ClearBurnQueueCommand}"
                                        Padding="12,6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Queue List -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <ListView ItemsSource="{Binding BurnQueueItems}"
                                  AutomationProperties.Name="Burn Queue Items"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Status" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Image Path" Width="360" DisplayMemberBinding="{Binding ImagePath}" />
                                    <GridViewColumn Header="Speed" Width="80" DisplayMemberBinding="{Binding WriteSpeedMultiplier, StringFormat='{}{0:0.##}x', TargetNullValue='Auto'}" />
                                    <GridViewColumn Header="Verify" Width="70" DisplayMemberBinding="{Binding VerifyAfterBurn}" />
                                    <GridViewColumn Header="Details / Message" Width="260" DisplayMemberBinding="{Binding ErrorMessage}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Bottom Action Ribbon -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="After Burn Action:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailablePostBurnActions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Action"
                                          SelectedValue="{Binding SelectedPostBurnAction}"
                                          AutomationProperties.Name="After Burn Action"
                                          Width="230" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛑 Cancel"
                                        AutomationProperties.Name="Cancel Burn Queue"
                                        Command="{Binding CancelCommand}"
                                        Background="#D83B01"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,0,8,0" />
                                <Button Content="▶ Run Burn Queue"
                                        AutomationProperties.Name="Run Burn Queue"
                                        Command="{Binding RunBurnQueueCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
