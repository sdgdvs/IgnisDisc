<UserControl x:Class="CdBurner.App.Views.DataBurnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DataBurnViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:FileSystemPresetToStringConverter x:Key="PresetToString" />

        <ObjectDataProvider x:Key="FileSystemPresets"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:FileSystemPreset" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Settings & Profiles Panel -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: El Torito Boot Configuration (Expander) -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: File Explorer Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Compilation Tree DataGrid -->
            <RowDefinition Height="*" />
            <!-- Row 4: Bottom Action & Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP SETTINGS & FILESYSTEM PROFILE CARD                             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Volume Label -->
                <TextBlock Grid.Column="0"
                           Text="Volume Label:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         AutomationProperties.Name="Volume Label"
                         Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="32"
                         VerticalAlignment="Center"
                         Padding="6,4"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}" />

                <!-- Filesystem Preset Profile -->
                <TextBlock Grid.Column="3"
                           Text="Filesystem Profile:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="4"
                          AutomationProperties.Name="Filesystem Profile"
                          ItemsSource="{Binding Source={StaticResource FileSystemPresets}}"
                          SelectedItem="{Binding SelectedFileSystemPreset}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PresetToString}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Options Checkboxes: their own row, wrapping on narrow windows -->
                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox Content="Close / Finalize Disc"
                              AutomationProperties.Name="Close / Finalize Disc"
                              IsChecked="{Binding CloseDisc}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Verify After Burn"
                              AutomationProperties.Name="Verify After Burn"
                              IsChecked="{Binding VerifyAfterBurn}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Direct drive commands (experimental)"
                              AutomationProperties.Name="Direct drive commands (experimental)"
                              IsChecked="{Binding UseDirectDriveCommands}"
                              ToolTip="Burn with IgnisDisc's own drive commands instead of the Windows writer, at a speed taken from the drive's own list for the disc, then read the disc back to check it. Covers blank CD-R, CD-RW, DVD-R, DVD-RW, DVD+R (single and dual layer), DVD+RW, DVD-RAM, and single-layer BD-R and BD-RE so far; other discs are burned by the Windows writer as before."
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Add SHA256SUMS"
                              AutomationProperties.Name="Add SHA256SUMS"
                              ToolTip="Adds a SHA256SUMS file to the disc root. Years from now, 'sha256sum -c SHA256SUMS' (Linux/macOS) or PowerShell can check every file without IgnisDisc."
                              IsChecked="{Binding WriteSha256Manifest}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Add BLAKE3SUMS"
                              AutomationProperties.Name="Add BLAKE3SUMS"
                              ToolTip="Adds a BLAKE3SUMS file to the disc root. 'b3sum -c BLAKE3SUMS' (the official BLAKE3 tool) can check every file later. Can be used together with SHA256SUMS."
                              IsChecked="{Binding WriteBlake3Manifest}"
                              VerticalAlignment="Center" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: EL TORITO BOOT CONFIGURATION EXPANDER                              -->
        <!-- ========================================================================= -->
        <Expander Grid.Row="1"
                  AutomationProperties.Name="El Torito Boot Configuration"
                  IsExpanded="{Binding IsBootableEnabled, Mode=TwoWay}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1"
                  Padding="12,8"
                  Margin="0,0,0,12">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Enable El Torito Bootable Disc (BIOS / UEFI Multi-Boot)"
                              AutomationProperties.Name="Enable El Torito Bootable Disc (BIOS / UEFI Multi-Boot)"
                              IsChecked="{Binding IsBootableEnabled, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <TextBlock Text="⚡ Master bootable recovery, OS installation, and diagnostic media"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <Grid Margin="12,10,12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- BIOS Boot Image -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="x86 BIOS Boot Image:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         AutomationProperties.Name="x86 BIOS Boot Image Path"
                         Text="{Binding BiosBootImagePath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4"
                         Margin="0,4,8,4"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                <Button Grid.Row="0" Grid.Column="2"
                        Content="📂 Browse..."
                        AutomationProperties.Name="Browse x86 BIOS Boot Image"
                        Command="{Binding BrowseBiosBootImageCommand}"
                        Margin="0,4" />

                <!-- UEFI Boot Image -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="EFI/UEFI Boot Image:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         AutomationProperties.Name="EFI/UEFI Boot Image Path"
                         Text="{Binding UefiBootImagePath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4"
                         Margin="0,4,8,4"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                <Button Grid.Row="1" Grid.Column="2"
                        Content="📂 Browse..."
                        AutomationProperties.Name="Browse EFI/UEFI Boot Image"
                        Command="{Binding BrowseUefiBootImageCommand}"
                        Margin="0,4" />
            </Grid>
        </Expander>

        <!-- ========================================================================= -->
        <!-- ROW 2: EXPLORER ACTION TOOLBAR                                            -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="📁+ Add Files"
                            AutomationProperties.Name="Add Files"
                            Command="{Binding AddFilesCommand}"
                            ToolTip="Add individual files to current virtual folder"
                            Margin="0,0,6,0" />
                    <Button Content="📂+ Add Folder"
                            AutomationProperties.Name="Add Folder"
                            Command="{Binding AddFolderCommand}"
                            ToolTip="Add local directory and contents to compilation"
                            Margin="0,0,6,0" />
                    <Button Content="➕ New Folder"
                            AutomationProperties.Name="New Folder"
                            Command="{Binding CreateVirtualFolderCommand}"
                            ToolTip="Create virtual folder inside current directory"
                            Margin="0,0,6,0" />
                    <Button Content="❌ Remove"
                            AutomationProperties.Name="Remove"
                            Command="{Binding RemoveSelectedItemCommand}"
                            ToolTip="Remove selected item from compilation"
                            Margin="0,0,12,0" />
                    <Button Content="⬆️ Up"
                            AutomationProperties.Name="Navigate Up"
                            Command="{Binding NavigateUpFolderCommand}"
                            ToolTip="Navigate up to parent folder"
                            Margin="0,0,6,0" />
                </StackPanel>

                <!-- Center: Breadcrumb Path -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Folder:"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CurrentFolderPath}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Bold" />
                </StackPanel>

                <!-- Right: Import Previous Session -->
                <Button Grid.Column="2"
                        Content="📥 Import Session"
                        AutomationProperties.Name="Import Session"
                        Command="{Binding ImportPreviousSessionCommand}"
                        ToolTip="Import previous session directory tree from optical media" />
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: COMPILATION TREE / ITEMS DATAGRID                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                AllowDrop="True"
                Drop="OnFileDrop">
            <DataGrid ItemsSource="{Binding CurrentItems}"
                      AutomationProperties.Name="Data Compilation Items"
                      SelectedItem="{Binding SelectedItem}"
                      MouseDoubleClick="OnDataGridDoubleClick"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Icon + Name -->
                    <DataGridTemplateColumn Header="Name" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type Description -->
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding TypeDescription}"
                                        Width="160" />

                    <!-- Size -->
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding DisplaySize}"
                                        Width="120" />

                    <!-- Virtual Path -->
                    <DataGridTextColumn Header="Virtual Path"
                                        Binding="{Binding VirtualPath}"
                                        Width="200" />

                    <!-- Source File Path -->
                    <DataGridTextColumn Header="Source Location"
                                        Binding="{Binding SourcePath}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 4: BOTTOM ACTION & METRICS BAR                                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Multi-layer discs only (DVD±R DL, BD DL, BDXL): what lands on each layer and where the drive
                     changes layer. Hidden for single-layer discs. -->
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.Name="Layer split preview"
                           Text="{Binding LayerSplitText, Mode=OneWay}"
                           ToolTip="Where this compilation lands on each layer of the disc. Windows' writer fills layer 0 first; reading slows briefly at a layer change.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Left: File metrics & status line -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalFilesCount, StringFormat='{}{0} file(s)'}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="|" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" />
                    <TextBlock Text="{Binding CapacityUsedMbText}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="|" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <!-- Center: Progress Bar when active -->
                <ProgressBar Grid.Column="1"
                             AutomationProperties.Name="Burn Progress"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding BurnProgress}"
                             Margin="24,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <!-- Right: Master Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Burn To:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />
                    <ComboBox Width="250"
                              AutomationProperties.Name="Burn To Optical Drive"
                              ItemsSource="{Binding AvailableRecorders}"
                              SelectedItem="{Binding SelectedRecorder}"
                              ToolTip="Select the optical drive to burn this Data Disc to"
                              Margin="0,0,12,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="💾 Export ISO..."
                            AutomationProperties.Name="Export ISO"
                            Command="{Binding ExportIsoCommand}"
                            ToolTip="Compile and build ISO disc image to disk"
                            Margin="0,0,10,0" />
                    <Button Content="🛑 Cancel Burn"
                            AutomationProperties.Name="Cancel Burn"
                            Command="{Binding CancelBurnCommand}"
                            Background="#D83B01"
                            Foreground="White"
                            FontWeight="Bold"
                            ToolTip="Cancel the ongoing burn and stop the drive"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,10,0"
                            MinWidth="110" />
                    <Button Content="🔥 Burn to Disc"
                            AutomationProperties.Name="Burn to Disc"
                            Command="{Binding StartDataBurnCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="Burn compilation to selected optical recorder"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                            MinWidth="120" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
