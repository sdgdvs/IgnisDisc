<UserControl x:Class="CdBurner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:core="clr-namespace:CdBurner.Core;assembly=CdBurner.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16" MaxWidth="800" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <!-- Row 0: Burning Defaults Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Directories & External Tools Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Appearance & System Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Online Services & Updates Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Action Buttons Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: BURNING DEFAULTS CARD                                             -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🔥 Optical Burning Defaults"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Default Target Optical Drive -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Default Target Optical Drive:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="Default Target Optical Drive"
                                  ItemsSource="{Binding AvailableRecorders}"
                                  SelectedItem="{Binding SelectedRecorder}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Default Write Speed Multiplier -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Default Write Speed Multiplier:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="Default Write Speed Multiplier"
                                  ItemsSource="{Binding AvailableSpeeds}"
                                  SelectedItem="{Binding DefaultWriteSpeedMultiplier}" />
                        <TextBlock Grid.Column="2"
                                   Text="(0 indicates Maximum supported speed)"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <!-- Verify After Burn -->
                    <CheckBox Content="Automatically verify media after burn completion"
                              AutomationProperties.Name="Automatically verify media after burn completion"
                              IsChecked="{Binding VerifyAfterBurnByDefault}"
                              Margin="0,0,0,8" />

                    <!-- Strict verify -->
                    <CheckBox Content="Strict verify: force every read from the disc (several times slower)"
                              AutomationProperties.Name="Strict verify: force every read from the disc (several times slower)"
                              ToolTip="Off: the check forces the drive to read the disc itself only where its memory could still hold burn data (the start and the last part written) and reads the rest at normal speed. On: every read is forced."
                              IsChecked="{Binding StrictVerify}"
                              Margin="0,0,0,8" />

                    <!-- Eject After Burn -->
                    <CheckBox Content="Eject optical drive tray when burn completes"
                              AutomationProperties.Name="Eject optical drive tray when burn completes"
                              IsChecked="{Binding EjectAfterBurnByDefault}"
                              Margin="0,0,0,8" />

                    <!-- Buffer Underrun Protection -->
                    <CheckBox Content="Enable buffer underrun protection (BURN-Proof / Burn-Free)"
                              AutomationProperties.Name="Enable buffer underrun protection (BURN-Proof / Burn-Free)"
                              IsChecked="{Binding EnableBurnFreeByDefault}" />
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: DIRECTORIES & EXTERNAL TOOLS (1-CLICK INSTALL)                    -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📁 Staging Directories &amp; Optional External Tools"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Temp Staging Directory -->
                    <TextBlock Text="Temporary Scratch / ISO Staging Directory:"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox AutomationProperties.Name="Temporary Scratch / ISO Staging Directory"
                             Text="{Binding TempStagingDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"
                             Margin="0,0,0,12" />

                    <!-- FFmpeg Path + 1-Click Install -->
                    <TextBlock Text="FFmpeg Transcoder Executable Path (DVD-Video):"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 AutomationProperties.Name="FFmpeg Transcoder Executable Path"
                                 Text="{Binding FfmpegExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5"
                                 VerticalAlignment="Center"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <Button Grid.Column="1"
                                Content="⬇ Install FFmpeg (1-Click LGPL)"
                                AutomationProperties.Name="Install FFmpeg (1-Click LGPL)"
                                Command="{Binding InstallFfmpegCommand}"
                                ToolTip="Downloads the official LGPL Windows build of FFmpeg and its license into %LOCALAPPDATA%\Programs\ffmpeg"
                                Padding="12,5"
                                Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding FfmpegStatusText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <!-- par2cmdline + 1-Click Install -->
                    <TextBlock Text="PAR2 Archive Recovery Tool (par2cmdline):"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Par2StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="⬇ Install par2 (1-Click)"
                                AutomationProperties.Name="Install par2 (1-Click)"
                                Command="{Binding InstallPar2Command}"
                                ToolTip="Downloads par2cmdline (par2.exe) into %LOCALAPPDATA%\Programs\par2cmdline for multi-disc archive parity recovery"
                                Padding="12,5"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 2: APPEARANCE & SYSTEM                                               -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎨 Appearance &amp; Diagnostics"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Theme Selection -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Visual Theme Mode:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="Visual Theme Mode"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding ThemeMode}" />
                    </Grid>

                    <!-- Virtual Drive Simulator Toggle -->
                    <CheckBox Content="Enable software-defined virtual optical drive emulator"
                              AutomationProperties.Name="Enable software-defined virtual optical drive emulator"
                              IsChecked="{Binding EnableVirtualDrive}"
                              Margin="0,0,0,12" />

                    <!-- Log Buffer Capacity -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Diagnostic Ring Buffer Capacity:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="Diagnostic Ring Buffer Capacity"
                                 Text="{Binding LogRingBufferCapacity, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 3: ONLINE SERVICES & UPDATES                                         -->
            <!-- ========================================================================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🌐 Online Services &amp; Updates"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <CheckBox Content="Look up Audio CD album &amp; track names from MusicBrainz by default"
                              AutomationProperties.Name="Look up Audio CD album and track names from MusicBrainz by default"
                              IsChecked="{Binding LookupMusicBrainzByDefault}"
                              ToolTip="Sends only the disc's table-of-contents DiscID to musicbrainz.org; never sends audio or personal data."
                              Margin="0,0,0,8" />

                    <CheckBox Content="Verify ripped Audio CD tracks against AccurateRip by default"
                              AutomationProperties.Name="Verify ripped Audio CD tracks against AccurateRip by default"
                              IsChecked="{Binding VerifyAccurateRipByDefault}"
                              ToolTip="Checks extracted track CRCs against the AccurateRip pressing database."
                              Margin="0,0,0,12" />

                    <!-- Opt-in Checkbox -->
                    <CheckBox Content="Check for newer versions automatically on startup (strictly opt-in)"
                              AutomationProperties.Name="Check for newer versions automatically on startup"
                              IsChecked="{Binding CheckForUpdatesOnStartup}"
                              Margin="0,0,0,12" />

                    <!-- Manual check button and status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Check for Updates Now"
                                AutomationProperties.Name="Check for Updates Now"
                                Command="{Binding CheckForUpdatesCommand}"
                                Padding="16,6"
                                Margin="0,0,12,0" />
                        <TextBlock Text="{Binding UpdateStatusMessage}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:LegalBanner.Line1}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{x:Static core:LegalBanner.Line2}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Source Code &amp; Issues: https://github.com/tether-works/IgnisDisc"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10.5"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 4: ACTION BUTTONS FOOTER                                              -->
            <!-- ========================================================================= -->
            <DockPanel Grid.Row="4" LastChildFill="False">
                <Button Content="Save Settings"
                        AutomationProperties.Name="Save Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Padding="20,8"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentForegroundBrush}"
                        FontWeight="SemiBold"
                        Margin="0,0,12,0" />

                <Button Content="Reset to Defaults"
                        AutomationProperties.Name="Reset to Defaults"
                        Command="{Binding ResetSettingsCommand}"
                        Padding="16,8"
                        Margin="0,0,16,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
