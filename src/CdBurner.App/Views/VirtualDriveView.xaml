<UserControl x:Class="CdBurner.App.Views.VirtualDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VirtualDriveViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Drive Selection & Controls -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Active Medium Status Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Preset & Custom Image Mounting Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Simulated Defect LBA Injection Workbench -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: RECORDER SELECTOR & TRAY CONTROLS                                  -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Virtual Recorder:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,10,0" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableRecorders}"
                              SelectedItem="{Binding SelectedRecorder}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2"
                            Content="⏏ Eject Tray"
                            Command="{Binding EjectMediaCommand}"
                            Margin="10,0,0,0"
                            Padding="12,5" />

                    <Button Grid.Column="3"
                            Content="📥 Close Tray"
                            Command="{Binding CloseTrayCommand}"
                            Margin="6,0,0,0"
                            Padding="12,5" />

                    <TextBlock Grid.Column="4"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: ACTIVE MEDIUM STATUS CARD                                         -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="💿 Mounted Virtual Disc Medium"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MEDIA TYPE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding MediaType}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTAL CAPACITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TotalCapacitySectors, StringFormat='{}{0:N0} LBAs'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RECORDED SECTORS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding UsedSectors, StringFormat='{}{0:N0} LBAs'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="STATUS / PROPERTIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding MediaSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 2: PRESET & CUSTOM IMAGE MOUNTING                                     -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📦 Mount Virtual Optical Media Presets"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Quickly insert blank virtual optical disc media into the drive emulator."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Preset Buttons -->
                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="💿 CD-R (700 MB)" Command="{Binding MountCdRCommand}" Padding="14,6" Margin="0,0,8,6" />
                        <Button Content="💿 CD-RW (700 MB)" Command="{Binding MountCdRwCommand}" Padding="14,6" Margin="0,0,8,6" />
                        <Button Content="📀 DVD-R (4.7 GB)" Command="{Binding MountDvdRCommand}" Padding="14,6" Margin="0,0,8,6" />
                        <Button Content="📀 DVD-RW (4.7 GB)" Command="{Binding MountDvdRwCommand}" Padding="14,6" Margin="0,0,8,6" />
                        <Button Content="📀 DVD+R DL (8.5 GB)" Command="{Binding MountDvdPlusRDLCommand}" Padding="14,6" Margin="0,0,8,6" />
                    </WrapPanel>

                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12" />

                    <!-- Custom Image Mount -->
                    <TextBlock Text="Mount Custom Image File (.iso, .bin)"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomImageFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <Button Grid.Column="1"
                                Content="Mount Image File"
                                Command="{Binding MountImageFileCommand}"
                                Margin="8,0,0,0"
                                Padding="16,5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 3: SIMULATED BAD SECTOR INJECTION WORKBENCH                           -->
            <!-- ========================================================================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="⚡ Simulated Bad Sector (LBA) Injection Workbench"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />

                    <TextBlock Text="Inject artificial read errors at specific LBA sector addresses to test ripping, verification, and surface scanner error handling."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Injection Input Toolbar -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Target Sector LBA:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,10,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding NewBadLba, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" />

                        <Button Grid.Column="2"
                                Content="Inject Bad Sector"
                                Command="{Binding InjectBadLbaCommand}"
                                Margin="10,0,0,0"
                                Padding="14,5"
                                Background="{DynamicResource CapacityOverburnBrush}"
                                Foreground="{DynamicResource AccentForegroundBrush}" />

                        <Button Grid.Column="3"
                                Content="Clear All Bad LBAs"
                                Command="{Binding ClearBadLbasCommand}"
                                Margin="8,0,0,0"
                                Padding="14,5" />
                    </Grid>

                    <!-- Active Bad Sectors List -->
                    <Border Background="{DynamicResource StatusBarBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            MaxHeight="160">
                        <ListBox ItemsSource="{Binding SimulatedBadLbas}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StringFormat='Defective Sector at LBA {0:N0}'}"
                                                   FontFamily="Cascadia Code, Consolas"
                                                   Foreground="{DynamicResource CapacityOverburnBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
