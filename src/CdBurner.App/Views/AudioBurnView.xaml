<UserControl x:Class="CdBurner.App.Views.AudioBurnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:audio="clr-namespace:CdBurner.Core.Audio;assembly=CdBurner.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioBurnViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:AudioRecordingModeToBooleanConverter x:Key="RecordingModeConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- ========================================================================= -->
            <!-- TAB 1: AUDIO CD MASTERING STUDIO                                         -->
            <!-- ========================================================================= -->
            <TabItem Header="🎵 Audio CD Master" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <!-- Row 0: CD-Text Metadata & Recording Mode Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Duration Bar & Capacity Meter -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Track Actions Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Tracks DataGrid -->
                        <RowDefinition Height="*" />
                        <!-- Row 4: Bottom Burn Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 0: CD-TEXT METADATA & RECORDING MODE -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Album Title -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Album Title:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding AlbumTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />

                            <!-- Performer / Artist -->
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="Performer:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="4"
                                     Text="{Binding AlbumPerformer, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />

                            <!-- Songwriter & UPC/EAN Sub-row -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Songwriter:"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <TextBox Width="150"
                                         Text="{Binding AlbumSongwriter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Margin="0,0,16,0" />

                                <TextBlock Text="UPC/EAN:"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <TextBox Width="120"
                                         Text="{Binding UpcEanCode, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="13"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </StackPanel>

                            <!-- Recording Mode & DSP Options Sub-row -->
                            <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Mode:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <RadioButton Content="Gapless DAO"
                                             IsChecked="{Binding RecordingMode, Converter={StaticResource RecordingModeConverter}, ConverterParameter=DiscAtOnceGapless}"
                                             ToolTip="Disc-at-Once: seamless continuous gapless audio and Lead-In CD-Text"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                                <RadioButton Content="TAO"
                                             IsChecked="{Binding RecordingMode, Converter={StaticResource RecordingModeConverter}, ConverterParameter=TrackAtOnce}"
                                             ToolTip="Track-at-Once: 2-second link blocks between tracks"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0" />

                                <CheckBox Content="Normalize Peaks (DSP)"
                                          IsChecked="{Binding NormalizeAllTracks}"
                                          ToolTip="Apply 0 dBFS peak normalization across all audio tracks"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 1: DURATION BAR & CAPACITY METER -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock HorizontalAlignment="Left"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Total Duration: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text="{Binding TotalDurationText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <Run Text=" | " Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding TotalTracksText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Capacity Used: " />
                                    <Run Text="{Binding DiscUsageText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </Grid>

                            <ProgressBar Grid.Row="1"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DiscUsagePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Border>

                    <!-- ROW 2: TRACK ACTIONS TOOLBAR -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="🎵+ Add Audio Files..."
                                        Command="{Binding AddAudioFilesCommand}"
                                        ToolTip="Add WAV, MP3, FLAC, or OGG tracks to compilation"
                                        Margin="0,0,6,0" />
                                <Button Content="❌ Remove"
                                        Command="{Binding RemoveTrackCommand}"
                                        ToolTip="Remove selected audio track"
                                        Margin="0,0,12,0" />
                                <Button Content="⬆️ Move Up"
                                        Command="{Binding MoveTrackUpCommand}"
                                        ToolTip="Move selected track earlier in sequence"
                                        Margin="0,0,6,0" />
                                <Button Content="⬇️ Move Down"
                                        Command="{Binding MoveTrackDownCommand}"
                                        ToolTip="Move selected track later in sequence"
                                        Margin="0,0,12,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="Red Book CD-DA: 44.1 kHz, 16-bit Stereo PCM"
                                       FontStyle="Italic"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ROW 3: TRACKS DATAGRID -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <DataGrid ItemsSource="{Binding Tracks}"
                                  SelectedItem="{Binding SelectedTrack}"
                                  AllowDrop="True"
                                  PreviewDragOver="OnPreviewDragOver"
                                  Drop="OnDrop"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource CardBackgroundBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding TrackNumber}"
                                                    Width="45"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Title"
                                                    Binding="{Binding Title}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Performer / Artist"
                                                    Binding="{Binding Performer}"
                                                    Width="180" />
                                <DataGridTextColumn Header="Pre-Gap"
                                                    Binding="{Binding PreGapText}"
                                                    Width="90"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Duration"
                                                    Binding="{Binding DurationText}"
                                                    Width="100"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Size"
                                                    Binding="{Binding FileSizeFormatted}"
                                                    Width="90"
                                                    IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Normalize"
                                                        Binding="{Binding NormalizeAudio}"
                                                        Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ROW 4: BOTTOM BURN & STATUS BAR -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8"
                            Padding="16,10"
                            Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Burn To:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox Width="260"
                                          ItemsSource="{Binding AvailableRecorders}"
                                          SelectedItem="{Binding SelectedRecorder}"
                                          ToolTip="Select the optical drive to burn this Audio CD to">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="🔥 Burn Audio CD"
                                    Command="{Binding StartAudioBurnCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="24,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 2: AUDIO CD RIPPER (DIGITAL AUDIO EXTRACTION)                         -->
            <!-- ========================================================================= -->
            <TabItem Header="💿 Audio CD Ripper" Padding="12,6" FontSize="13">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ripper Destination Folder Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Output Folder:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding RipOutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="2"
                                    Content="📂 Browse..."
                                    Command="{Binding BrowseRipOutputFolderCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ripper Options & Capabilities Description -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Extraction Specifications &amp; Metadata Preservation"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="• Extracts Red Book CD-DA raw 2,352-byte sectors to uncompressed canonical 44.1 kHz 16-bit Stereo RIFF WAVE (.wav) files."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2" />
                            <TextBlock Text="• Generates companion CDRWIN / Red Book CUE sheet ('album.cue') preserving track sequence, pre-gaps, and Lead-In CD-Text."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2" />
                            <TextBlock Text="• Automatic bad-sector retries and hardware defect logging."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2" />
                        </StackPanel>
                    </Border>

                    <!-- Spacer / Ripper Results Card -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Ready for Digital Audio Extraction"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Select source optical drive below, configure destination directory, and click 'Rip Audio CD'."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom Rip Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Rip From:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox Width="260"
                                          ItemsSource="{Binding AvailableRecorders}"
                                          SelectedItem="{Binding SelectedRecorder}"
                                          ToolTip="Select the optical drive containing the Audio CD to rip">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="💿 Rip Audio CD"
                                    Command="{Binding RipAudioCdCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="24,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
