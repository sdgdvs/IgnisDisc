<UserControl x:Class="CdBurner.App.Views.AudioBurnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             xmlns:converters="clr-namespace:CdBurner.App.Converters"
             xmlns:audio="clr-namespace:CdBurner.Core.Audio;assembly=CdBurner.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioBurnViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:AudioRecordingModeToBooleanConverter x:Key="RecordingModeConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- ========================================================================= -->
            <!-- TAB 1: AUDIO CD MASTERING STUDIO                                         -->
            <!-- ========================================================================= -->
            <TabItem Header="🎵 Audio CD Master" Padding="12,6" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <!-- Row 0: CD-Text Metadata & Recording Mode Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Duration Bar & Capacity Meter -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Track Actions Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Tracks DataGrid -->
                        <RowDefinition Height="*" />
                        <!-- Row 4: Bottom Burn Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 0: CD-TEXT METADATA & RECORDING MODE -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Album Title -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Album Title:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding AlbumTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />

                            <!-- Performer / Artist -->
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="Performer:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="4"
                                     Text="{Binding AlbumPerformer, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" />

                            <!-- Songwriter & UPC/EAN Sub-row -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Songwriter:"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <TextBox Width="150"
                                         Text="{Binding AlbumSongwriter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Margin="0,0,16,0" />

                                <TextBlock Text="UPC/EAN:"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <TextBox Width="120"
                                         Text="{Binding UpcEanCode, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="13"
                                         Padding="6,4"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </StackPanel>

                            <!-- Recording Mode & DSP Options Sub-row -->
                            <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Mode:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <RadioButton Content="Gapless DAO"
                                             IsChecked="{Binding RecordingMode, Converter={StaticResource RecordingModeConverter}, ConverterParameter=DiscAtOnceGapless}"
                                             ToolTip="Disc-at-Once: seamless continuous gapless audio"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                                <RadioButton Content="TAO"
                                             IsChecked="{Binding RecordingMode, Converter={StaticResource RecordingModeConverter}, ConverterParameter=TrackAtOnce}"
                                             ToolTip="Track-at-Once: 2-second link blocks between tracks"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0" />

                                <CheckBox Content="Normalize Peaks"
                                          IsChecked="{Binding NormalizeAllTracks}"
                                          ToolTip="Apply -0.1 dBFS peak normalization across all audio tracks"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <CheckBox Content="Level Loudness (RMS)"
                                          IsChecked="{Binding UseRmsLoudnessLeveling}"
                                          ToolTip="ReplayGain / EBU-style perceptual RMS loudness leveling (-14 dBFS) across all tracks"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <TextBlock Text="Crossfade (s):"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,6,0" />
                                <TextBox Width="42"
                                         Text="{Binding CrossfadeSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4,2"
                                         TextAlignment="Center"
                                         ToolTip="Equal-power crossfade duration in seconds between adjacent tracks (0 = off)"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 1: DURATION BAR & CAPACITY METER -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock HorizontalAlignment="Left"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Total Duration: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text="{Binding TotalDurationText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <Run Text=" | " Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding TotalTracksText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Capacity Used: " />
                                    <Run Text="{Binding DiscUsageText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </Grid>

                            <ProgressBar Grid.Row="1"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DiscUsagePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Border>

                    <!-- ROW 2: TRACK ACTIONS TOOLBAR -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="🎵+ Add Audio / FLAC / CUE / Playlist..."
                                        Command="{Binding AddAudioFilesCommand}"
                                        ToolTip="Add FLAC, WAV, MP3, M4A/AAC, OGG, WMA, CUE sheets, or M3U/M3U8/PLS playlists"
                                        Margin="0,0,6,0" />
                                <Button Content="▶️ Preview"
                                        Command="{Binding PreviewSelectedTrackCommand}"
                                        ToolTip="Listen to a Red Book preview of the selected track"
                                        Margin="0,0,4,0" />
                                <Button Content="⏹️ Stop"
                                        Command="{Binding StopPreviewCommand}"
                                        Visibility="{Binding IsPreviewPlaying, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Stop audio preview playback"
                                        Margin="0,0,8,0" />
                                <Button Content="❌ Remove"
                                        Command="{Binding RemoveTrackCommand}"
                                        ToolTip="Remove selected audio track"
                                        Margin="0,0,6,0" />
                                <Button Content="🗑️ Clear All"
                                        Command="{Binding ClearAllTracksCommand}"
                                        ToolTip="Remove all tracks from compilation"
                                        Margin="0,0,10,0" />
                                <Button Content="⬆️"
                                        Command="{Binding MoveTrackUpCommand}"
                                        ToolTip="Move selected track earlier in sequence"
                                        Margin="0,0,4,0" />
                                <Button Content="⬇️"
                                        Command="{Binding MoveTrackDownCommand}"
                                        ToolTip="Move selected track later in sequence"
                                        Margin="0,0,10,0" />
                                <Button Content="🖨️ Export Cover &amp; Tracklist..."
                                        Command="{Binding ExportCoverSheetCommand}"
                                        ToolTip="Generate a printable 120mm x 120mm CD Jewel Case Front Booklet, 150mm x 118mm Rear Tray Inlay, and Track Sheet" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="FLAC, WAV, MP3, M4A, OGG, CUE, M3U/M3U8/PLS  →  Red Book CD-DA"
                                       FontStyle="Italic"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ROW 3: TRACKS DATAGRID -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Tracks}"
                                      SelectedItem="{Binding SelectedTrack}"
                                      AllowDrop="True"
                                      PreviewDragOver="OnPreviewDragOver"
                                      Drop="OnDrop"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="{DynamicResource CardBackgroundBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding TrackNumber}"
                                                        Width="45"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Title"
                                                        Binding="{Binding Title}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Performer / Artist"
                                                        Binding="{Binding Performer}"
                                                        Width="170" />
                                    <DataGridTextColumn Header="Format"
                                                        Binding="{Binding FormatSummary}"
                                                        Width="145"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Pre-Gap"
                                                        Binding="{Binding PreGapText}"
                                                        Width="85"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Duration"
                                                        Binding="{Binding DurationText}"
                                                        Width="95"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Size"
                                                        Binding="{Binding FileSizeFormatted}"
                                                        Width="85"
                                                        IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="Normalize"
                                                            Binding="{Binding NormalizeAudio}"
                                                            Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty-state overlay when no tracks are added -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Margin="24"
                                        Visibility="{Binding HasTracks, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Drop FLAC, WAV, MP3, M4A, OGG, WMA, or CUE files here"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Supports 16/24/32-bit lossless FLAC (44.1–192 kHz), single-file FLAC + CUE albums, Vorbis Comment tags, and folders — automatically decoded to Red Book 44.1 kHz 16-bit Stereo CD-DA."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="640"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 4: BOTTOM BURN & STATUS BAR -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8"
                            Padding="16,10"
                            Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Burn To:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox Width="260"
                                          ItemsSource="{Binding AvailableRecorders}"
                                          SelectedItem="{Binding SelectedRecorder}"
                                          ToolTip="Select the optical drive to burn this Audio CD to">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛑 Cancel Burn"
                                        Command="{Binding CancelBurnCommand}"
                                        Background="#D83B01"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        ToolTip="Cancel ongoing burn and stop drive"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,0,8,0" />
                                <Button Content="🔥 Burn Audio CD"
                                        Command="{Binding StartAudioBurnCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 2: AUDIO CD RIPPER (DIGITAL AUDIO EXTRACTION)                         -->
            <!-- ========================================================================= -->
            <TabItem Header="💿 Audio CD Ripper" Padding="12,6" FontSize="13">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ripper Destination Folder Card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Output Folder:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding RipOutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="2"
                                    Content="📂 Browse..."
                                    Command="{Binding BrowseRipOutputFolderCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ripper Options & Accuracy Settings Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Read Offset Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Read offset (samples):"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ReadOffsetSamples, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Margin="0,0,8,0"
                                         ToolTip="Drive read offset correction in samples (-10000 to +10000) for sample-accurate ripping" />
                                <Button Grid.Column="2"
                                        Content="🔎 Detect"
                                        Command="{Binding DetectReadOffsetCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip="Detect drive read offset using an inserted commercial Audio CD against AccurateRip" />
                            </Grid>

                            <!-- CheckBoxes -->
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="Secure rip (C2 re-reads)"
                                          IsChecked="{Binding SecureRip}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Use C2 error pointers to verify audio sectors and re-read corrupted samples." />
                                <CheckBox Content="Look up track names (MusicBrainz)"
                                          IsChecked="{Binding LookupMetadata}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Fetch album and track titles from MusicBrainz before ripping." />
                                <CheckBox Content="Verify with AccurateRip"
                                          IsChecked="{Binding VerifyAccurateRip}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,20,2"
                                          ToolTip="Cross-reference extracted track checksums with the online AccurateRip database." />
                                <CheckBox Content="Continue past unreadable sectors"
                                          IsChecked="{Binding ContinueOnUnreadable}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,2,0,2"
                                          ToolTip="Zero-fill unreadable sectors with silence instead of aborting the rip." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Spacer / Ripper Results Card -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <!-- Ready Placeholder (Collapsed when RipReport has content) -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RipReport}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RipReport}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Ready for Digital Audio Extraction"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Select source optical drive below, configure destination directory, and click 'Rip Audio CD'."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Monospace Consolas Rip Report (Collapsed when empty) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="{x:Type ScrollViewer}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RipReport}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RipReport}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <TextBox Text="{Binding RipReport, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         Padding="4" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Bottom Rip Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BurnProgress}"
                                             Margin="0,6,16,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Rip From:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <ComboBox Width="260"
                                          ItemsSource="{Binding AvailableRecorders}"
                                          SelectedItem="{Binding SelectedRecorder}"
                                          ToolTip="Select the optical drive containing the Audio CD to rip">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VolumePath}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding VendorId}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ProductId}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛑 Cancel Rip"
                                        Command="{Binding CancelBurnCommand}"
                                        Background="#D83B01"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        ToolTip="Cancel ongoing audio extraction"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Padding="18,10"
                                        FontSize="14"
                                        Margin="0,0,8,0" />
                                <Button Content="💿 Rip Audio CD"
                                        Command="{Binding RipAudioCdCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                                        Padding="24,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
