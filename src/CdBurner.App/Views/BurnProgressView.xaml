<UserControl x:Class="CdBurner.App.Views.BurnProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CdBurner.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BurnProgressViewModel}"
             Background="{DynamicResource SurfaceBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20"
            MaxWidth="680">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Operation Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Main Progress Bar & Action -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Telemetry Metrics Grid -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Live Log Drawer (Expander) -->
                <RowDefinition Height="*" />
                <!-- Row 4: Cancellation & Control Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding JobTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentActionText}"
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding PercentCompleteText}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Row 1: Main Progress Bar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <ProgressBar Height="14"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding PercentComplete}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}" />
            </StackPanel>

            <!-- Row 2: Telemetry Metrics Grid -->
            <Border Grid.Row="2"
                    Background="{DynamicResource RibbonBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Write Speed Telemetry -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="WRITE SPEED"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CurrentSpeedText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Buffer Gauge -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,8,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="DRIVE BUFFER"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BufferPercentText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding BufferFillPercent}"
                                     Foreground="{DynamicResource CapacitySafeBrush}"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- LBA Sector Counter -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,0,10">
                        <TextBlock Text="LBA SECTORS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding LbaText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Elapsed Time -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="ELAPSED TIME"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ElapsedTimeText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Remaining Time / ETA -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock Text="ESTIMATED REMAINING"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding RemainingTimeText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Status Indicator -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="STATUS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CurrentActionText}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 3: Live Expandable Log Drawer -->
            <Expander Grid.Row="3"
                      Header="Live Mastering Telemetry Log"
                      IsExpanded="True"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      Margin="0,0,0,16">
                <Border Background="{DynamicResource StatusBarBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,6,0,0"
                        Padding="8"
                        MaxHeight="160">
                    <ListBox ItemsSource="{Binding LiveLogLines}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>
            </Expander>

            <!-- Row 4: Controls & Cancellation -->
            <DockPanel Grid.Row="4" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="Cancel Operation"
                        Command="{Binding CancelBurnCommand}"
                        IsEnabled="{Binding CanCancel}"
                        Padding="16,6"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
