<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- Windows 11 Fluent Dark Mica / Surface Brushes                              -->
    <!-- ========================================================================= -->

    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RailSelectedBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#262626" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#181818" />

    <!-- Text & Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#767676" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#555555" />

    <!-- Windows 11 Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A86D9" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#006CBE" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- Capacity Meter Semantic Brushes -->
    <SolidColorBrush x:Key="CapacitySafeBrush" Color="#107C41" />
    <SolidColorBrush x:Key="CapacityWarningBrush" Color="#FF8C00" />
    <SolidColorBrush x:Key="CapacityOverburnBrush" Color="#D13438" />

    <!-- Control Elements & Interactive State Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#242424" />
    <SolidColorBrush x:Key="ControlDisabledBackgroundBrush" Color="#222222" />
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#333333" />

</ResourceDictionary>
